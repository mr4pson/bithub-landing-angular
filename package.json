    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/platform-server": "17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/ssr": "^20.3.4",
    "@nguniversal/builders": "16",
    "@nguniversal/express-engine": "^16.2.0",
    "@types/node": "^24.6.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.8",
